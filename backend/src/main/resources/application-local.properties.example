# Copy this file to application-local.properties and fill in your secrets.
# application-local.properties is gitignored and contains environment-specific values.

# --- Datasource ---
# WARNING: Development only. Use a strong password in production.
spring.datasource.password=YOUR_DB_PASSWORD_HERE

# --- JWT ---
# WARNING: Development only. Use a randomly generated secret in production.
jwt.secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARS
jwt.access-expiration-ms=900000
jwt.refresh-expiration-ms=604800000

# --- Verifier ---
verifier.cli.path=../verifier/dist/cli.js
verifier.timeout.seconds=30

# --- LLM ---
a11yforge.llm.anthropic.api-key=YOUR_ANTHROPIC_API_KEY_HERE

# --- Mail (Mailtrap) ---
# Credentials aus dem Mailtrap-Dashboard (Email Testing -> Inbox -> SMTP Settings)
spring.mail.username=YOUR_MAILTRAP_USERNAME
spring.mail.password=YOUR_MAILTRAP_PASSWORD