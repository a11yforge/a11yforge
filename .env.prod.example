# Copy this file to .env.prod and fill in the real values on the production
# server before starting the app with SPRING_PROFILES_ACTIVE=prod.
# These values are environment-specific and must NEVER be committed.

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Datasource ---
# WARNING: use a strong, randomly generated password in production.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DB_HOST:5432/a11yforge?stringtype=unspecified
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD_HERE

# --- JWT ---
# WARNING: use a randomly generated secret with at least 32 characters.
JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_CHARS

# --- LLM (Anthropic) ---
A11YFORGE_LLM_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# --- Mail (production SMTP provider) ---
SPRING_MAIL_HOST=YOUR_SMTP_HOST
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_SMTP_USERNAME
SPRING_MAIL_PASSWORD=YOUR_SMTP_PASSWORD
A11YFORGE_MAIL_FROM=no-reply@YOUR_DOMAIN

# --- Frontend ---
A11YFORGE_FRONTEND_BASE_URL=https://YOUR_FRONTEND_DOMAIN
